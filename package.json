{
  "name": "au-journey-web-workspace", 
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose -f docker/docker-compose.yml up -d --build", 
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "redis:backup": "./scripts/redis-backup.sh",
    "redis:restore": "./scripts/redis-restore.sh",
    "build": "./scripts/build.sh",
    "deploy": "./scripts/deploy.sh"
  }
}
